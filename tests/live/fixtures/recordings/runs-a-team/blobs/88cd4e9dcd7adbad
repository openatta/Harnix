[{"name":"Agent","description":"Launch a sub-agent to handle complex, multi-step tasks independently.\n\nAvailable subagent_type values:\n- claude: Claude AI assistant with full tool access\n- code-reviewer: Code review specialist using Read/Grep/Glob/LSP/Bash\n- explore: Read-only file search and exploration specialist\n- general-purpose: General-purpose AI coding agent with full tool access\n- plan: Software architect and planning specialist\n- worker: Worker agent executing a precisely-scoped task within a team\n\nDetailed guide: ToolSearch{\"query\":\"select:Agent\"}","input_schema":{"$defs":{"PermissionMode":{"description":"Permission mode for tool execution.","enum":["default","acceptEdits","bypassPermissions","plan","dontAsk"],"type":"string"}},"properties":{"background":{"default":false,"type":"boolean"},"description":{"type":["string","null"]},"model":{"type":["string","null"]},"name":{"description":"This member's name within `team_name`. Reuse the same pair to keep\nmessaging the same member.","type":["string","null"]},"output_schema":{"description":"A JSON Schema the sub-agent's final answer must satisfy; the answer is\nthen also returned as structured content."},"permission_mode":{"anyOf":[{"$ref":"#/$defs/PermissionMode"},{"type":"null"}],"description":"With `team_name` + `name`: the permission mode a new member runs under\nfor its whole lifetime (default `plan`, read-only). The first member\nspawned under a team fixes it for the team; messaging a live member\nignores it. `bubble` is rejected."},"prompt":{"type":"string"},"subagent_type":{"type":["string","null"]},"team_name":{"description":"A team to join, together with `name`. If that member is alive, `prompt`\nis queued as its next message instead of spawning a new one. Needs\nteam mode enabled for the session.","type":["string","null"]},"worktree":{"description":"Run the sub-agent in a git worktree of its own,\n`.agix/worktrees/<name>` on branch `agix/worktree-<name>`. Removed\nwhen the agent ends i