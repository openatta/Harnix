o find,\nmatched exactly, whitespace included.","type":["string","null"]},"replace_all":{"description":"Single edit: false (default) requires `old_string` to occur exactly\nonce; true replaces every occurrence.","type":["boolean","null"]}},"required":["file_path"],"type":"object"},"source":"builtin"},{"name":"EnterPlanMode","description":"Enter plan mode to design before implementing","input_schema":{"properties":{},"type":"object"},"source":"builtin"},{"name":"ExitPlanMode","description":"Exit plan mode with plan summary and permission requests","input_schema":{"properties":{},"type":"object"},"source":"builtin"},{"name":"Glob","description":"Find files by glob pattern (e.g. src/**/*.rs).\n\nDetailed guide: ToolSearch{\"query\":\"select:Glob\"}","input_schema":{"properties":{"max_results":{"default":1000,"description":"Maximum number of results to return. Default 1000.","minimum":0,"type":"integer"},"path":{"description":"Root directory to search; defaults to the current working directory.","type":["string","null"]},"pattern":{"description":"Shell-style glob pattern (e.g. \"*.rs\", \"**/*.toml\", \"src/**/test_*.rs\").","type":"string"},"respect_gitignore":{"default":true,"description":"When false, include files ignored by .gitignore. Default true.","type":"boolean"}},"required":["pattern"],"type":"object"},"source":"builtin"},{"name":"GoalCreate","description":"Set a goal that keeps this session working across automatic rounds until it is complete. Use it when the user's request is a long-running objective that one turn won't finish, even if they don't say \"goal\"; not for single-turn work.","input_schema":{"properties":{},"type":"object"},"source":"builtin"},{"name":"GoalGet","description":"Read this session's goal, including the id and revision GoalUpdate needs.","input_schema":{"properties":{},"type":"object"},"source":"builtin"},{"name":"GoalUpdate","description":"Change this session's goal: edit, pause, resume, complete or blocked. Mark complete only when the whole objective is achieved; difficulty or remaining work is not blocked.","input_schema":{"properties":{},"type":"object"},"source":"builtin"},{"name":"Grep","description":"Search file contents with regex (ripgrep-style).\n\nDetailed guide: ToolSearch{\"query\":\"select:Grep\"}","input_schema":{"properties":{"case_insensitive":{"description":"Case-insensitive match.","type":["boolean","null"]},"glob":{"description":"Glob filter restricting which files to search (e.g. \"*.rs\").","type":["string","null"]},"head_limit":{"description":"Cap output lines; default 250 in content mode.","minimum":0,"type":["integer","null"]},"line_numbers":{"description":"Prefix each line with its line number (content mode only).","type":["boolean","null"]},"multiline":{"description":"Enable multiline mode where . matches newlines and ^/$ match line boundaries.","type":["boolean","null"]},"output_mode":{"description":"\"files_with_matches\" (default), \"content\", or \"count\".","type":["string","null"]},"path":{"description":"Root directory; defaults to cwd.","type":["string","null"]},"pattern":{"description":"Regex pattern to search for (Rust regex syntax).","type":"string"}},"required":["pattern"],"type":"object"},"source":"builtin"},{"name":"ListPeers","description":"List the labels of the teammates you can send messages to.\n\nDetailed guide: ToolSearch{\"query\":\"select:ListPeers\"}","input_schema":{"additionalProperties":false,"properties":{},"type":"object"},"source":"builtin"},{"name":"Monitor","description":"Start a background script that streams stdout lines as events.","input_schema":{"properties":{},"type":"object"},"source":"builtin"},{"name":"Read","description":"Read a file (text/image/PDF) with optional line range.\n\nDetailed guide: ToolSearch{\"query\":\"select:Read\"}","input_schema":{"description":"`Read` 工具的输入 schema。","properties":{"file_path":{"description":"The absolute path to the file to read. Relative paths are resolved\nagainst the current working directory