{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The suites moved over from plain JavaScript unchanged (M1-6), so they
    // are checked for what they call, not annotated parameter by parameter.
    "strict": false,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "fixtures"]
}
