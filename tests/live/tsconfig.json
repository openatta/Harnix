{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // A test indexes into what it set up or what the recording answers, and a key that is not
    // there throws where it is read and fails the test: `!` on every such read would say nothing.
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "fixtures"]
}
